{
  "name": "assistente-rh-ti",
  "version": "1.0.0",
  "private": true,
  "description": "Agente LangGraph (RAG + tools HTTP) para helpdesk interno de RH/TI",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:web && tsc -p tsconfig.build.json",
    "build:web": "esbuild web/app.ts --bundle --format=iife --target=es2022 --outfile=public/app.js",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "cli": "tsx src/presentation/cli/cli.ts",
    "ingest": "tsx scripts/ingest.ts",
    "bench:latency": "tsx scripts/bench-latency.ts",
    "bench:load": "tsx scripts/bench-load.ts",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@langchain/core": "^1.2.8",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/textsplitters": "^1.0.1",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "dotenv": "^16.6.1",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/testing": "^11.2.1",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "autocannon": "^8.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
