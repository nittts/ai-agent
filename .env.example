# =============================================================================
# Assistente RH/TI — exemplo de configuração
# Copie para .env e ajuste. NUNCA comite o .env.
# =============================================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------
# gemini = usa a API real do Google AI Studio (exige GEMINI_API_KEY)
# fake   = modelo determinístico embutido; roda sem credencial nenhuma.
#          É o modo usado por `npm test` e pelo CI.
LLM_PROVIDER=gemini

# Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo FIXADO de propósito: não use o ponteiro `gemini-flash-latest`.
# Um ponteiro móvel torna o eval/results/latency.csv irreproduzível, porque o
# modelo pode mudar entre a medição e a apresentação.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Atenção: `text-embedding-004` foi DESLIGADO pelo Google.
# `gemini-embedding-001` é o modelo de texto GA atual.
GEMINI_EMBED_MODEL=gemini-embedding-001

# Preço por 1M de tokens, usado pelo medidor de custo por request.
COST_PER_1M_INPUT_USD=0.3
COST_PER_1M_OUTPUT_USD=2.5

# -----------------------------------------------------------------------------
# Resiliência
# -----------------------------------------------------------------------------
# Teto de UMA tentativa. NUNCA pode exceder REQUEST_DEADLINE_MS — o boot recusa
# essa configuração, porque uma tentativa que não cabe na promessa é incoerente.
LLM_TIMEOUT_MS=8000
LLM_MAX_RETRIES=2

# Prazo TOTAL do request, compartilhado por todos os nós. É o botão que limita
# a cauda: timeout por tentativa multiplica, prazo absoluto limita.
REQUEST_DEADLINE_MS=15000
TOOL_TIMEOUT_MS=3000
TOOL_MAX_RETRIES=1

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
RETRIEVAL_TOP_K=4
# Limiar do nó `grade`: abaixo disso o agente RECUSA em vez de responder.
# É o botão que troca alucinação por "não sei". Valor calibrado em eval/.
RETRIEVAL_MIN_SCORE=0.55
CORPUS_PATH=./corpus
INDEX_PATH=./eval/index-snapshot.json

# -----------------------------------------------------------------------------
# Cache (opcional — ausente, o serviço funciona sem cache)
# -----------------------------------------------------------------------------
# 127.0.0.1, não `localhost`: o Node 18+ prefere IPv6, e um serviço que escuta
# só em IPv4 fica inalcançável por `localhost`. Mesma armadilha do HR_API_BASE_URL.
REDIS_URL=redis://127.0.0.1:6379
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# API mock (fonte B)
# -----------------------------------------------------------------------------
# HR_API_BASE_URL — deixe COMENTADO.
#
# A API de RH e simulada dentro deste processo, em /mock/v1, entao o padrao
# acompanha a PORT automaticamente. Defina isto apenas para apontar para um
# sistema de RH de verdade. Fixar a porta aqui e copiar o arquivo para um PaaS,
# que sorteia a porta, faz toda pergunta sobre dados do colaborador responder
# que o sistema de RH nao respondeu.
# HR_API_BASE_URL=http://127.0.0.1:3000/mock/v1
# Habilita POST /mock/v1/_chaos, usado pelo toggle "derrubar API mock" do console
# para demonstrar o comportamento degradado ao vivo. Deixe false em produção.
CHAOS_ENABLED=true

# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=assistente-rh-ti
